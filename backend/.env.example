# Production Environment Template
PORT=8005
NODE_ENV=production
# In production, specify a high-entropy secret (min 32 random characters)
JWT_SECRET=replace_with_strong_production_secret_key_32chars_min

# Database & Cache Configurations (TLS enabled)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority
REDIS_URL=rediss://default:<password>@<redis-host>:<redis-port>

# Allowed CORS Origins (comma-separated if multiple)
ALLOWED_ORIGINS=https://manager.ficapp.in,https://manager-website.onrender.com,https://manager-website-three.vercel.app

# =============================================================================
# Cloudinary Media & Document Storage (REQUIRED)
# AWS S3 has been removed. All file uploads use Cloudinary exclusively.
# Set CLOUDINARY_URL alone, OR set all three individual vars below.
# =============================================================================
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>

# Backend public URL (used to resolve relative media paths)
BACKEND_URL=https://manager-website.onrender.com
